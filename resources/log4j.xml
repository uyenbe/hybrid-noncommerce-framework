<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE log4j:configuration SYSTEM "log4j.dtd">

<log4j:configuration xmlns:log4j="http://jakarta.apache.org/log4j/">

<!--
appender: muốn log ra cái gì
+ console
+ logfile: có 2 dạng
    - lưu đè: name="Append" value="false"
    - lưu tiếp: name="append" value="true"
+ file
+ testng: add log vào testNG và report testNG >> t config appender riêng trong thư mục acton
-->
    <appender name="console" class="org.apache.log4j.ConsoleAppender">

        <param name="Target" value="System.out" />
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="[%d %c] %m%n" />
        </layout>
    </appender>

    <appender name="logfile" class="org.apache.log4j.FileAppender">
        <param name="File" value="./logs/NopCommerce.log" />
        <param name="Append" value="false" />
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="[%d %c] %m%n" />
        </layout>
    </appender>

    <appender name="file" class="org.apache.log4j.RollingFileAppender">
        <param name="file" value="./logs/NopCommerceRolling.log" />
        <param name="append" value="true" />
        <param name="maxFileSize" value="10MB" />
        <param name="maxBackupIndex" value="10" />
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="[%d %c] %m%n" />
        </layout>
    </appender>

    <appender name="testng" class="logConfig.TestNGAppender">
        <param name="Threshold" value="INFO" />
        <layout class="org.apache.log4j.PatternLayout">
            <param name="ConversionPattern" value="[%d %c] %m%n" />
        </layout>
    </appender>
<!--
    Copy các package cần show log vào đây
-->
    <category name="com.nopcommerce.users">
        <priority value="all" />
        <appender-ref ref="console" />
        <appender-ref ref="logfile" />
        <appender-ref ref="file" />
        <appender-ref ref="testng" />
    </category>

    <root>
        <priority value="warn" />
    </root>

</log4j:configuration>